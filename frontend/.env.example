# Where the FastAPI backend is. Routes carry no /api prefix.
VITE_API_URL=http://localhost:8000

# The admin login signs in against Supabase Auth directly, so these two are
# needed to reach /admin and are unused by the student chat. Without them the
# sign-in screen says so rather than offering a form that cannot work.
#
# Both are publishable: the anon key is the one Supabase ships for browsers, and
# every table has row level security with default-deny, so it reaches no rows.
# All data still comes from the backend above, which holds the service role key
# (AGENTS.md section 6.7). Never put the service role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
