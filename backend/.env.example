# Copy to backend/.env and fill in. Never commit .env.

# --- Supabase project (required) -------------------------------------------
# Both are backend-only secrets. The frontend never sees these; it gets the
# publishable/anon key and talks only to Supabase Auth.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Gemini (required from Phase 2 onward) ---------------------------------
# Optional in Phase 1: no provider is implemented yet, and requiring it would
# block offline verification.
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004
# Must match vector(768) in the chunks table.
EMBEDDING_DIMENSIONS=768

# --- Retrieval tuning ------------------------------------------------------
# Tune with eval/run_eval.py in Phase 6.
SIMILARITY_THRESHOLD=0.55
TOP_K=5
MAX_UPLOAD_MB=20

# --- Admin auth ------------------------------------------------------------
# Tokens are verified against the project JWKS at
# {SUPABASE_URL}/auth/v1/.well-known/jwks.json. There is no SUPABASE_JWT_SECRET:
# that is the legacy symmetric scheme, and projects created since May 2025 issue
# asymmetric (ES256) tokens. The JWKS URL is derived from SUPABASE_URL.
JWT_AUDIENCE=authenticated
JWT_LEEWAY_SECONDS=10
JWKS_CACHE_SECONDS=300

# --- Server ----------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
ENVIRONMENT=local
LOG_LEVEL=INFO
